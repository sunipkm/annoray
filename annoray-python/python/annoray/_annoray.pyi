class DataTree:
    """A tree of datasets (netCDF-4 groups) with inherited dimension coordinates."""
    def __init__(self, dataset: Dataset | None = None) -> None: ...
    @staticmethod
    def from_dict(d: Mapping[str, Dataset]) -> DataTree: ...
    @property
    def paths(self) -> list[str]: ...
    @property
    def dataset(self) -> Dataset: ...
    @property
    def children(self) -> dict[str, DataTree]: ...
    def __getitem__(self, path: str) -> DataTree: ...
    def __contains__(self, path: str) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def to_dataset(self, path: str = "/", inherit: bool = True) -> Dataset: ...
    def load(self) -> DataTree: ...
    def to_netcdf(self, path: _Path, format: str = "NETCDF4") -> None: ...
    def to_xarray(self) -> Any: ...

