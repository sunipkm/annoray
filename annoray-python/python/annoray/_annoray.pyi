        current: int = 0,
        temperature: int = 0,
        amount: int = 0,
        luminosity: int = 0,
        angle: int = 0,
    ) -> None: ...
    @property
    def exponents(self) -> dict[str, int]: ...
    @property
    def dimensionless(self) -> bool: ...
    def __mul__(self, other: Dimension | type) -> Dimension: ...
    def __rmul__(self, other: Dimension | type) -> Dimension: ...
    def __truediv__(self, other: Dimension | type) -> Dimension: ...
    def __rtruediv__(self, other: Dimension | type | int) -> Dimension: ...
    def __pow__(self, n: int, modulo: None = None) -> Dimension: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

