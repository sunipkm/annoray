"""Type stubs for annoray's Rust extension module (`annoray._annoray`).

`Quantity` and `DataArray` are generic over a named dimension (`annoray.dims.Length`, …):
`Quantity[Length]` in annotations documents the dimension for type checkers, and
`annoray.dims.checked` enforces it at run time. Arithmetic results are `Quantity[Any]`:
Python's type system cannot compute dimensions (Rust's `Quantity<_D>` does).
"""

import os
from collections.abc import Hashable, Iterable, Iterator, Mapping, Sequence
from typing import Any, Generic, Literal, TypeAlias, TypeVar, overload

import numpy as np
import numpy.typing as npt

_D = TypeVar("_D")

__version__: str

_Path: TypeAlias = str | os.PathLike[str]
_Dims: TypeAlias = str | Sequence[str] | None
_Reduction: TypeAlias = Literal[
    "sum",
    "prod",
    "mean",
    "median",
    "std",
    "var",
    "min",
    "max",
    "count",
    "argmin",
    "argmax",
    "any",
    "all",
]

class UnitError(ValueError):
    """Incompatible or unknown units (e.g. adding metres to seconds)."""

class Dimension:
    """A physical dimension: exponents of the base quantities (SI and angle)."""
    def __init__(
        self,
        *,
        mass: int = 0,
        length: int = 0,
        time: int = 0,
        current: int = 0,
        temperature: int = 0,
        amount: int = 0,
        luminosity: int = 0,
        angle: int = 0,
    ) -> None: ...
    @property
    def exponents(self) -> dict[str, int]: ...
    @property
    def dimensionless(self) -> bool: ...
    def __mul__(self, other: Dimension | type) -> Dimension: ...
    def __rmul__(self, other: Dimension | type) -> Dimension: ...
    def __truediv__(self, other: Dimension | type) -> Dimension: ...
    def __rtruediv__(self, other: Dimension | type | int) -> Dimension: ...
    def __pow__(self, n: int, modulo: None = None) -> Dimension: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Unit:
    """A unit of measurement, parsed and checked when made."""
    def __init__(self, unit: str | Unit) -> None: ...
    @property
    def dimension(self) -> Dimension: ...
    @property
    def dimensionless(self) -> bool: ...
    @property
    def canonical(self) -> str: ...
    def is_convertible(self, other: str | Unit) -> bool: ...
    @overload
    def __mul__(self, other: str | Unit) -> Unit: ...
    @overload
    def __mul__(self, other: float) -> Quantity[Any]: ...
    def __rmul__(self, other: float) -> Quantity[Any]: ...
    def __truediv__(self, other: str | Unit) -> Unit: ...
    @overload
    def __rtruediv__(self, other: str | Unit) -> Unit: ...
    @overload
    def __rtruediv__(self, other: float) -> Quantity[Any]: ...
    def __pow__(self, n: int, modulo: None = None) -> Unit: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Quantity(Generic[_D]):
    """A number with a unit; `Quantity[Length]` names its dimension for type checkers."""
    def __init__(self, magnitude: float, units: str | Unit | None = None) -> None: ...
    @property
    def magnitude(self) -> float: ...
    @property
    def units(self) -> str: ...
    @property
    def unit(self) -> Unit: ...
    @property
    def dimension(self) -> Dimension: ...
    def to(self, units: str | Unit) -> Quantity[_D]: ...
    def __add__(self, other: Quantity[Any] | float) -> Quantity[_D]: ...
    def __radd__(self, other: float) -> Quantity[_D]: ...
    def __sub__(self, other: Quantity[Any] | float) -> Quantity[_D]: ...
    def __rsub__(self, other: float) -> Quantity[_D]: ...
    @overload
    def __mul__(self, other: Quantity[Any] | float | Unit) -> Quantity[Any]: ...
    @overload
    def __mul__(self, other: DataArray[Any]) -> DataArray[Any]: ...
    def __rmul__(self, other: float) -> Quantity[Any]: ...
    @overload
    def __truediv__(self, other: Quantity[Any] | float | Unit) -> Quantity[Any]: ...
    @overload
    def __truediv__(self, other: DataArray[Any]) -> DataArray[Any]: ...
    def __rtruediv__(self, other: float) -> Quantity[Any]: ...
    def __pow__(self, n: int, modulo: None = None) -> Quantity[Any]: ...
    def __neg__(self) -> Quantity[_D]: ...
    def __pos__(self) -> Quantity[_D]: ...
    def __abs__(self) -> Quantity[_D]: ...
    def __float__(self) -> float: ...
    def __lt__(self, other: Quantity[Any] | float) -> bool: ...
    def __le__(self, other: Quantity[Any] | float) -> bool: ...
    def __gt__(self, other: Quantity[Any] | float) -> bool: ...
    def __ge__(self, other: Quantity[Any] | float) -> bool: ...
    def __format__(self, spec: str) -> str: ...

