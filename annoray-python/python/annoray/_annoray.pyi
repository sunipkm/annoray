    def __init__(
        self,
        data_vars: Mapping[str, Any] | None = None,
        coords: Mapping[str, Any] | None = None,
        attrs: Mapping[str, Any] | None = None,
    ) -> None: ...
    @property
    def data_vars(self) -> dict[str, DataArray[Any]]: ...
    @property
    def coords(self) -> dict[str, DataArray[Any]]: ...
    @property
    def dims(self) -> tuple[str, ...]: ...
    @property
    def sizes(self) -> dict[str, int]: ...
    @property
    def attrs(self) -> dict[str, Any]: ...
    def keys(self) -> list[str]: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __getattr__(self, name: str) -> DataArray[Any]: ...
    @overload
    def __getitem__(self, key: str) -> DataArray[Any]: ...
    @overload
    def __getitem__(self, key: list[str]) -> Dataset: ...
    def assign(self, variables: Mapping[str, Any] | None = None, **kwargs: Any) -> Dataset: ...
    def transpose(self, *dims: str | Any) -> Dataset: ...
    def drop_vars(self, names: str | Sequence[str]) -> Dataset: ...
    def set_coords(self, names: str | Sequence[str]) -> Dataset: ...
    def load(self) -> Dataset: ...
    def compute(self) -> Dataset: ...
    def isel(self, indexers: Mapping[str, Any] | None = None, **kwargs: Any) -> Dataset: ...
    def sel(
        self,
        indexers: Mapping[str, Any] | None = None,
        method: str | None = None,
        tolerance: Any = None,
        **kwargs: Any,
    ) -> Dataset: ...
    def fillna(self, value: float) -> Dataset: ...
    def dropna(self, dim: str, how: Literal["any", "all"] = "any") -> Dataset: ...
    def reindex(self, indexers: Mapping[str, Any] | None = None, **kwargs: Any) -> Dataset: ...
    def interp(
        self, coords: Mapping[str, Any] | None = None, method: str = "linear", **kwargs: Any
    ) -> Dataset: ...
    def groupby(self, group: str) -> GroupBy: ...
    def groupby_bins(
        self, group: str, bins: Sequence[float], right: bool = True, include_lowest: bool = False
    ) -> GroupBy: ...
    def resample(self, indexer: Mapping[str, str] | None = None, **kwargs: str) -> GroupBy: ...
    def rolling(
        self,
        dim: Mapping[str, int] | None = None,
        center: bool = False,
        min_periods: int | None = None,
        **kwargs: int,
    ) -> Rolling: ...
    def to_netcdf(
        self,
        path: _Path,
        format: str = "NETCDF4",
        encoding: Mapping[str, Mapping[str, Any]] | None = None,
        unlimited_dims: Sequence[str] | None = None,
    ) -> None: ...
    def to_xarray(self) -> Any: ...

class GroupBy(_Reductions):
    """Groups of a data array or dataset (`groupby`, `groupby_bins`, `resample`)."""
    def first(self) -> Any: ...
    def last(self) -> Any: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[tuple[Any, Any]]: ...
    def __add__(self, other: DataArray[Any]) -> DataArray[Any]: ...
